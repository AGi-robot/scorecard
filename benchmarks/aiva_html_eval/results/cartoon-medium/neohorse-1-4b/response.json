24px rgba(0,0,0,0.5);\n        position: relative;\n        overflow: hidden;\n    }\n    svg { width: 100%; height: 100%; display: block; }\n\n    /* --- Controls --- */\n    .controls {\n        display: flex;\n        gap: 1rem;\n        margin-bottom: 1rem;\n        z-index: 20;\n    }\n    button {\n        padding: 0.6rem 1.2rem;\n        border: 1px solid var(--border);\n        background: var(--card-bg);\n        color: var(--text);\n        border-radius: 0.5rem;\n        font-size: 0.9rem;\n        cursor: pointer;\n        font-weight: 600;\n        transition: all 0.2s;\n        font-family: var(--font);\n    }\n    button:hover {\n        border-color: var(--accent);\n        background: rgba(56, 189, 248, 0.1);\n        transform: translateY(-1px);\n    }\n    button:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }\n    #play-btn { border-color: var(--accent); color: var(--accent); }\n    #play-btn:hover { background: var(--accent-glow); }\n\n    /* --- Step Label --- */\n    #step-label {\n        display: inline-block;\n        margin-bottom: 0.5rem;\n        font-size: 0.9rem;\n        color: var(--accent);\n        font-weight: 700;\n        letter-spacing: 0.05em;\n    }\n\n    /* --- Log Area --- */\n    .log-area {\n        width: 100%;\n        max-width: 600px;\n        height: 60px;\n        background: var(--card-bg);\n        border: 1px solid var(--border);\n        border-radius: 0.5rem;\n        padding: 0.8rem 1rem;\n        font-family: 'Courier New', Courier, monospace;\n        font-size: 0.85rem;\n        color: var(--text-secondary);\n        overflow-y: auto;\n        display: flex;\n        flex-wrap: wrap;\n        gap: 0.5rem;\n        align-content: flex-start;\n        line-height: 1.5;\n    }\n    .log-entry {\n        animation: fadeIn 0.3s ease;\n    }\n    .log-entry.highlight { color: var(--accent); }\n\n    /* --- Footer / Optional --- */\n    .footer-legend {\n        display: flex;\n        flex-wrap: wrap;\n        gap: 2rem;\n        justify-content: center;\n        padding-top: 1rem;\n        margin-top: 0.5rem;\n        font-size: 0.75rem;\n        color: var(--text-secondary);\n    }\n    .legend-item { display: flex; align-items: center; gap: 0.4rem; }\n    .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }\n\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }\n\n    @media (prefers-reduced-motion: reduce) {\n        * { animation: none !important; }\n        .log-area { overflow: visible; }\n    }\n</style>\n</head>\n<body>\n\n<header>\n    <h1>AIVA <span>&amp;</span> Grace</h1>\n    <div class=\"status-bar\" id=\"status-bar\">Ready</div>\n</header>\n\n<main>\n    <div id=\"step-label\" style=\"display:none;\">STEP 0/6</div>\n\n    <div id=\"viz-container\">\n        <svg id=\"architecture-svg\" viewBox=\"0 0 800 450\" xmlns=\"http://www.w3.org/2000/svg\">\n            <defs>\n                <filter id=\"glow\">\n                    <feGaussianBlur stdDeviation=\"3\" result=\"blur\" />\n                    <feMerge><feMergeNode in=\"blur\" /><feMergeNode in=\"SourceGraphic\"/></feMerge>\n                </filter>\n                <filter id=\"softGlow\">\n                    <feGaussianBlur stdDeviation=\"4\" />\n                </filter>\n                <linearGradient id=\"grad1\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"0%\" stop-color=\"#38bdf8\" stop-opacity=\"0.3\"/>\n                    <stop offset=\"100%\" stop-color=\"#38bdf8\" stop-opacity=\"0\"/>\n                </linearGradient>\n            </defs>\n            <g id=\"animation-layer\"></g>\n        </svg>\n    </div>\n\n    <div class=\"controls\">\n        <button id=\"reset-btn\">Reset</button>\n        <button id=\"next-btn\">Next Step</button>\n        <button id=\"play-btn\">▶ Play Demo</button>\n    </div>\n\n    <div class=\"log-area\" id=\"log-area\">\n        <span style=\"color:#64748b\">System ready. Press \"Next Step\" or \"Play Demo\" to begin.</span>\n    </div>\n\n    <div class=\"footer-legend\">\n        <div class=\"legend-item\"><span class=\"dot\" style=\"background:#38bdf8\"></span> User Console</div>\n        <div class=\"legend-item\"><span class=\"dot\" style=\"background:#f59e0b\"></span> ROS / Network</div>\n        <div class=\"legend-item\"><span class=\"dot\" style=\"background:#a855f7\"></span> Receptor</div>\n        <div class=\"legend-item\"><span class=\"dot\" style=\"background:#22c55e\"></span> Interactive (Python)</div>\n        <div class=\"legend-item\"><span class=\"dot\" style=\"background:#ef4444\"></span> Router (llama.cpp)</div>\n        <div class=\"legend-item\"><span class=\"dot\" style=\"background:#64748b\"></span> Memory (SQLite)</div>\n        <div class=\"legend-item\" style=\"margin-left:auto\"><span class=\"dot\" style=\"background:#eab308\"></span> Grace</div>\n    </div>\n</main>\n\n<script>\n    /**\n     * AIVA DEMO ARCHITECTURE SIMULATION\n     * Steps:\n     * 0: User composes message\n     * 1: Console encodes (Cypher) & pushes ROS\n     * 2: Receptor decodes & hands to Interactive\n     * 3: Interactive assembles Persona + Memory (SQLite)\n     * 4: Interactive calls Router (llama.cpp)\n     * 5: Response streams back to Console\n     * 6: Memory saves exchange\n     */\n\n    // --- State ---\n    const STATE = {\n        step: 0,\n        maxStep: 6,\n        playing: false,\n        intervalId: null,\n        textStream: []\n    };\n\n    // --- DOM Elements ---\n    const svg = document.getElementById('architecture-svg');\n    const animLayer = document.getElementById('animation-layer');\n    const stepLabel = document.getElementById('step-label');\n    const logArea = document.getElementById('log-area');\n    const nextBtn = document.getElementById('next-btn');\n    const resetBtn = document.getElementById('reset-btn');\n    const playBtn = document.getElementById('play-btn');\n    const statusBar = document.getElementById('status-bar');\n\n    // --- SVG Assets (Inline Paths) ---\n\n    // 1. User\n    const USER_PATH = \"M40,80 C20,80 10,100 10,140 C10,180 20,220 40,240 L60,240 C80,220 90,180 90,140 C90,100 80,80 60,80 Z\";\n    const USER_FACE = \"M45,130 Q55,110 65,130 Q55,150 45,130\";\n    const USER_BODY = \"M10,140 L90,140 L85,240 L15,240 Z\";\n\n    // 2. Console\n    const CONS_PATH = \"M100,100 L250,100 L250,250 L100,250 Z\";\n    const CONS_SCREEN = \"M110,110 L240,110 L235,240 L115,240 Z\";\n\n    // 3. Router\n    const ROUTER_PATH = \"M400,100 L420,100 L430,140 L420,160 L400,160 Z\"; // Chip shape\n    const ROUTER_BODY = \"M380,100 L440,100 L430,160 L390,160 Z\";\n\n    // 4. Receptor\n    const REC_PATH = \"M550,100 L590,100 L620,140 L590,160 L550,160 Z\";\n    const REC_EAR = \"M560,120 Q560,80 590,80 Q610,80 610,110 Q610,140 560,140\";\n\n    // 5. Interactive\n    const INT_PATH = \"M700,100 L750,100 L760,140 L750,160 L700,160 Z\";\n    const INT_BR = \"M710,130 Q710,90 740,90 Q750,90 755,120 Q755,140 710,140\";\n\n    // 6. Memory\n    const MEM_PATH = \"M780,200 L810,200 L820,240 L810,280 L780,280 Z\";\n    const MEM_CYL = \"M790,220 L800,220 L800,270 L780,270 Z\";\n\n    // 7. Grace\n    const GRACE_PATH = \"M380,280 L420,280 L430,320 L420,340 L380,340 Z\";\n    const GRACE_HEAD = \"M390,300 Q400,260 420,260 Q430,260 430,300 Q430,320 390,320\";\n\n    // --- Helper: Draw SVG ---\n    function drawNode(id, x, y, path, subPath, label, color) {\n        const g = document.createElementNS(\"http://www.w3.org/2000/svg\", \"g\");\n        g.setAttribute(\"id\", id);\n        g.setAttribute(\"class\", \"node-group\");\n        g.style.transform = `translate(${x}px, ${y}px)`;\n        \n        const circle = document.createElementNS(\"http://www.w3.org/2000/svg\", \"circle\");\n        circle.setAttribute(\"r\", 20);\n        circle.setAttribute(\"fill\", \"transparent\");\n        circle.setAttribute(\"stroke\", color);\n        circle.setAttribute(\"stroke-width\", 2);\n        \n        const rect = document.createElementNS(\"http://www.w3.org/2000/svg\", \"rect\");\n        rect.setAttribute(\"rx\", 8);\n        rect.setAttribute(\"fill\", \"#1e293b\");\n        rect.setAttribute(\"stroke\", color);\n        rect.setAttribute(\"stroke-width\", 1.5);\n        rect.setAttribute(\"width\", \"100\");\n        rect.setAttribute(\"height\", \"60\");\n        rect.setAttribute(\"x\", -50);\n        rect.setAttribute(\"y\", 10);\n\n        const text = document.createElementNS(\"http://www.w3.org/2000/svg\", \"text\");\n        text.setAttribute(\"x\", 0);\n        text.setAttribute(\"y\", 40);\n        text.setAttribute(\"text-anchor\", \"middle\");\n        text.setAttribute(\"fill\", \"#e2e8f0\");\n        text.setAttribute(\"font-size\", \"10\");\n        text.setAttribute(\"font-weight\", \"bold\");\n        text.textContent = label;\n\n        g.appendChild(circle);\n        g.appendChild(rect);\n        g.appendChild(text);\n        svg.appendChild(g);\n    }\n\n    function initDrawing() {\n        // Nodes\n        drawNode(\"user\", 100, 180, USER_PATH, USER_FACE, \"User\", \"#38bdf8\");\n        drawNode(\"console\", 280, 180, CONS_PATH, CONS_SCREEN, \"Console\", \"#38bdf8\");\n        drawNode(\"ros\", 360, 140, \"M350,140 L380,140 L370,180 L350,180 Z\", \"\", \"ROS Bridge\", \"#f59e0b\");\n        drawNode(\"receptor\", 550, 180, REC_PATH, REC_EAR, \"Receptor\", \"#a855f7\");\n        drawNode(\"interactive\", 700, 180, INT_PATH, INT_BR, \"Interactive\", \"#22c55e\");\n        drawNode(\"router\", 380, 300, ROUTER_PATH, \"\", \"Router\", \"#ef4444\");\n        drawNode(\"memory\", 780, 280, MEM_PATH, MEM_CYL, \"Memory\", \"#64748b\");\n        drawNode(\"grace\", 380, 340, GRACE_PATH, GRACE_HEAD, \"Grace\", \"#eab308\");\n    }\n\n    // --- Animation System ---\n    let packetEl = null;\n\n    function createPacket(currentX, currentY, duration) {\n        const rect = document.createElementNS(\"http://www.w3.org/2000/svg\", \"rect\");\n        rect.setAttribute(\"rx\", 4);\n        rect.setAttribute(\"fill\", \"#38bdf8\");\n        rect.setAttribute(\"width\", \"16\");\n        rect.setAttribute(\"height\", \"16\");\n        rect.setAttribute(\"x\", currentX);\n        rect.setAttribute(\"y\", currentY);\n        rect.classList.add(\"packet\");\n        animLayer.appendChild(rect);\n        return rect;\n    }\n\n    function removePacket(el) {\n        if (el && el.parentNode) el.parentNode.removeChild(el);\n    }\n\n    function animatePacket(startX, startY, endX, endY, duration, easing) {\n        return new Promise(resolve => {\n            const p = createPacket(startX, startY, duration);\n            // Store end coords on the element\n            p.dataset.endX = endX;\n            p.dataset.endY = endY;\n            p.dataset.duration = duration;\n            \n            const key = \"anim_\" + Date.now();\n            p.dataset.key = key;\n\n            const durationMs = duration * 1000;\n            const startTime = performance.now();\n\n            function tick(currentTime) {\n                const elapsed = (currentTime - startTime) / 1000;\n                if (elapsed >= duration) {\n                    removePacket(p);\n                    resolve();\n                    return;\n                }\n                // Ease\n                const ease = easing(elapsed, 0, 1, duration);\n                const currX = startX + (endX - startX) * ease;\n                const currY = startY + (endY - startY) * ease;\n                p.setAttribute(\"x\", currX);\n                p.setAttribute(\"y\", currY);\n                requestAnimationFrame(tick);\n            }\n            requestAnimationFrame(tick);\n        });\n    }\n\n    function animateStep(step) {\n        const log = document.createElement(\"span\");\n        log.className = \"log-entry highlight\";\n        log.style.cssText = \"margin-top:0.5rem\";\n        logArea.insertBefore(log, logArea.firstChild);\n\n        const duration = 2000; // ms per step\n\n        switch(step) {\n            case 0:\n                log.textContent = `User: \"How does AIVA remember our conversation?\"`;\n                // Draw packet at User\n                packetEl = animatePacket(100, 200, 280, 200, duration, t => 1 - Math.pow(1 - t, 1));\n                break;\n\n            case 1:\n                log.textContent = `Console: Encoded Cypher signal via ROS Bridge.`;\n                packetEl = animatePacket(280, 200, 360, 160, duration, t => 1 - Math.pow(1 - t, 1));\n                break;\n\n            case 2:\n                log.textContent = `Receptor: Decoded & passed to Interactive.`;\n                packetEl = animatePacket(360, 160, 550, 200, duration, t => 1 - Math.pow(1 - t, 1));\n                break;\n\n            case 3:\n                log.textContent = `Interactive: Assembling Persona + SQLite Memory.`;\n                // Draw packet to Interactive\n                packetEl = animatePacket(550, 200, 700, 200, duration, t => 1 - Math.pow(1 - t, 1));\n                break;\n\n            case 4:\n                log.textContent = `Router: llama.cpp (Nymphaea RP) streaming response...`;\n                // Draw packet to Router\n                packetEl = animatePacket(700, 200, 380, 300, duration, t => 1 - Math.pow(1 - t, 1));\n                break;\n\n            case 5:\n                log.textContent = `Response streamed back to Console Display.`;\n                // Return to Console\n                packetEl = animatePacket(380, 300, 280, 200, duration, t => 1 - Math.pow(1 - t, 1));\n                break;\n\n            case 6:\n                log.textContent = `Memory: Saved exchange. Grace is ready.`;\n                // Return to Grace/Memory\n                packetEl = animatePacket(280, 200, 380, 340, duration, t => 1 - Math.pow(1 - t, 1));\n                break;\n        }\n\n        // Update UI\n        stepLabel.style.display = 'block';\n        stepLabel.textContent = `STEP ${step} / ${STATE.maxStep}`;\n        statusBar.textContent = `Step: ${step}`;\n    }\n\n    function renderStep(step) {\n        if (STATE.step === step) return;\n        if (STATE.step > step) return; // Don't render future steps\n\n        STATE.step = step;\n        animateStep(step);\n\n        // Update labels\n        const labels = {\n            0: \"User Composing...\",\n            1: \"Cypher Encoding...\",\n            2: \"Decoding...\",\n            3: \"Consulting Memory...\",\n            4: \"Querying Router...\",\n            5: \"Streaming Response...\",\n            6: \"Saving to Memory...\"\n        };\n        if(step === 0) stepLabel.style.display = 'none';\n        else stepLabel.textContent = labels[step];\n    }\n\n    // --- API ---\n\n    function reset() {\n        stopPlayback();\n        STATE.step = 0;\n        STATE.playing = false;\n        clearLog();\n        logArea.innerHTML = '<span style=\"color:#64748b\">System reset. Ready.</span>';\n        renderStep(0);\n        updateControls();\n    }\n\n    function next() {\n        if (STATE.step < STATE.maxStep) {\n            renderStep(STATE.step + 1);\n            updateControls();\n        }\n    }\n\n    function getState() {\n        return { step: STATE.step, playing: STATE.playing };\n    }\n\n    function togglePlay() {\n        if (STATE.playing) {\n            stopPlayback();\n        } else {\n            startPlayback();\n        }\n    }\n\n    function startPlayback() {\n        if (STATE.step >= STATE.maxStep) return;\n        STATE.playing = true;\n        STATE.intervalId = setInterval(() => {\n            if (STATE.step < STATE.maxStep) {\n                renderStep(STATE.step + 1);\n                updateControls();\n            } else {\n                stopPlayback();\n                statusBar.textContent = \"Demo Complete\";\n                nextBtn.disabled = true;\n            }\n        }, 2000);\n    }\n\n    function stopPlayback() {\n        STATE.playing = false;\n        if (STATE.intervalId) clearInterval(STATE.intervalId);\n        STATE.intervalId = null;\n        updateControls();\n    }\n\n    function clearLog() {\n        logArea.innerHTML = '';\n    }\n\n    function updateControls() {\n        nextBtn.disabled = STATE.step >= STATE.maxStep;\n        if (!STATE.playing) {\n            playBtn.textContent = \"▶ Play Demo\";\n        } else {\n            playBtn.textContent = \"⏸ Pause\";\n        }\n    }\n\n    // --- Initialization ---\n    initDrawing();\n    updateControls();\n\n    // Attach global API\n    window.AIVA_DEMO = {\n        reset,\n        next,\n        togglePlay,\n        getState\n    };\n\n    // Event Listeners\n    nextBtn.addEventListener('click', next);\n    resetBtn.addEventListener('click', reset);\n    playBtn.addEventListener('click', togglePlay);\n\n    // Keyboard shortcut\n    document.addEventListener('keydown', (e) => {\n        if (e.key === 'Enter') next();\n        if (e.key === 'r' || e.key === 'R') reset();\n    });\n\n</script>\n</body>\n</html>",
