mn;gap:7px;min-width:210px;flex:1 1 220px;max-width:340px}\n  .dots{display:flex;gap:6px}\n  .dots button{\n    flex:1;height:10px;border-radius:6px;border:1px solid var(--line);background:#f1e8d8;\n    cursor:pointer;padding:0;transition:background .2s ease;\n  }\n  .dots button:focus-visible{outline:3px solid var(--teal);outline-offset:2px}\n  .dots button[aria-current=\"step\"]{background:var(--accent);border-color:var(--accent-deep)}\n  .dots button.done{background:var(--gold);border-color:#c9821f}\n  .step-label{font-size:.85rem;color:var(--ink-soft);font-weight:600;min-height:2.6em}\n  #step-label{color:var(--ink);font-weight:700}\n  /* ---------- message bubble ---------- */\n  .bubble-panel{\n    margin-top:16px;background:linear-gradient(180deg,#fffdf8,#fdf3e3);border:1px solid var(--line);\n    border-radius:var(--radius);padding:14px 18px;box-shadow:var(--shadow);\n  }\n  .bubble-panel h2,.panel-title{font-family:var(--font-display);font-size:.95rem;letter-spacing:.04em;text-transform:uppercase;color:var(--ink-soft);margin:0 0 8px}\n  .sample-msg{\n    display:flex;gap:12px;align-items:flex-start;\n  }\n  .sample-msg .avatar{flex:0 0 auto;width:44px;height:44px}\n  .msg-text{\n    background:#fff;border:1.5px solid var(--line);border-radius:14px 14px 14px 4px;\n    padding:10px 14px;font-size:1.02rem;box-shadow:0 3px 0 var(--line);\n  }\n  .msg-text .who{font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--teal-deep)}\n  .msg-text .sample{font-weight:700;color:var(--ink)}\n  .status-line{margin-top:10px;font-size:.85rem;color:var(--ink-soft);min-height:1.4em}\n  .status-line strong{color:var(--teal-deep)}\n  /* ---------- optional caps ---------- */\n  .optional{\n    margin-top:20px;border:1.5px dashed var(--gold);border-radius:var(--radius);\n    background:#fffaf0;padding:16px 18px;\n  }\n  .optional h2{font-family:var(--font-display);margin:0 0 4px;font-size:1.05rem;color:#8a5a10}\n  .optional p.note{margin:0 0 12p