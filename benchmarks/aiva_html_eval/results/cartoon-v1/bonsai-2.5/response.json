nd sent over ROS 2, decoded by the telepathy receptor, handed to Interactive, which uses Memory and the llama.cpp router running Nymphaea RP, and the reply streams back to the Console. A sidecar area shows optional Canvas, Imaging and MOSS features that are outside the main chat path.</desc>\n        <defs>\n          <filter id=\"soft\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\">\n            <feDropShadow dx=\"0\" dy=\"6\" stdDeviation=\"8\" flood-color=\"#1e2a4a\" flood-opacity=\"0.18\"/>\n          </filter>\n          <filter id=\"soft2\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\">\n            <feDropShadow dx=\"0\" dy=\"3\" stdDeviation=\"4\" flood-color=\"#1e2a4a\" flood-opacity=\"0.12\"/>\n          </filter>\n          <marker id=\"arrowBlue\" markerWidth=\"10\" markerHeight=\"10\" refX=\"8\" refY=\"5\" orient=\"auto-start-reverse\">\n            <path d=\"M0,0 L10,5 L0,10 Z\" fill=\"#1e60e0\"/>\n          </marker>\n          <marker id=\"arrowPink\" markerWidth=\"10\" markerHeight=\"10\" refX=\"8\" refY=\"5\" orient=\"auto-start-reverse\">\n            <path d=\"M0,0 L10,5 L0,10 Z\" fill=\"#e8538b\"/>\n          </marker>\n          <marker id=\"arrowGold\" markerWidth=\"10\" markerHeight=\"10\" refX=\"8\" refY=\"5\" orient=\"auto-start-reverse\">\n            <path d=\"M0,0 L10,5 L0,10 Z\" fill=\"#e7a50e\"/>\n          </marker>\n          <marker id=\"arrowGreen\" markerWidth=\"10\" markerHeight=\"10\" refX=\"8\" refY=\"5\" orient=\"auto-start-reverse\">\n            <path d=\"M0,0 L10,5 L0,10 Z\" fill=\"#178a50\"/>\n          </marker>\n        </defs>\n\n        <!-- ===== background ===== -->\n        <rect x=\"0\" y=\"0\" width=\"1200\" height=\"780\" rx=\"18\" fill=\"#f6f9fe\"/>\n        <g opacity=\"0.5\">\n          <circle cx=\"90\" cy=\"120\" r=\"26\" fill=\"#d9e4fb\"/>\n          <circle cx=\"1130\" cy=\"100\" r=\"34\" fill=\"#fde3ee\"/>\n          <circle cx=\"1150\" cy=\"620\" r=\"22\" fill=\"#e9e1fb\"/>\n          <circle cx=\"60\" cy=\"640\" r=\"30\" fill=\"#d9f2e6\"/>\n        </g>\n        <text x=\"600\" y=\"46\" text-anchor=\"middle\" font-size=\"20\" font-weight=\"800\" fill=\"#8b93a8\" letter-spacing=\"4\">THE TELEPATHY LOOP · AIVA PC RUNTIME</text>\n\n        <!-- ===== floor line ===== -->\n        <path d=\"M28 640 Q600 668 1172 640\" fill=\"none\" stroke=\"#d8dfeb\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n\n        <!-- ===== CONSOLE (user + browser) ===== -->\n        <g id=\"card0\" class=\"card\" data-card=\"0\">\n          <rect x=\"40\" y=\"150\" width=\"300\" height=\"330\" rx=\"18\" fill=\"#ffffff\" stroke=\"#d8dfeb\" stroke-width=\"1.5\"/>\n          <rect x=\"40\" y=\"150\" width=\"300\" height=\"46\" rx=\"18\" fill=\"#1e60e0\"/>\n          <rect x=\"40\" y=\"172\" width=\"300\" height=\"24\" fill=\"#1e60e0\"/>\n          <circle cx=\"66\" cy=\"173\" r=\"5\" fill=\"#fff\" opacity=\"0.85\"/>\n          <circle cx=\"84\" cy=\"173\" r=\"5\" fill=\"#fff\" opacity=\"0.85\"/>\n          <circle cx=\"102\" cy=\"173\" r=\"5\" fill=\"#fff\" opacity=\"0.85\"/>\n          <text x=\"190\" y=\"178\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"800\" fill=\"#fff\" font-family=\"ui-monospace,Menlo,monospace\">AIVA Console</text>\n          <text x=\"190\" y=\"196\" text-anchor=\"middle\" font-size=\"11\" fill=\"#bcd2f7\" font-family=\"ui-monospace,Menlo,monospace\">browser UI + HTTP/WebSocket server</text>\n\n          <!-- browser card -->\n          <rect x=\"60\" y=\"210\" width=\"260\" height=\"150\" rx=\"12\" fill=\"#f4f7fc\" stroke=\"#d8dfeb\" stroke-width=\"1.5\"/>\n          <rect x=\"60\" y=\"210\" width=\"260\" height=\"34\" rx=\"12\" fill=\"#e6ecf5\"/>\n          <rect x=\"60\" y=\"230\" width=\"260\" height=\"14\" fill=\"#e6ecf5\"/>\n          <rect x=\"76\" y=\"221\" width=\"150\" height=\"12\" rx=\"6\" fill=\"#fff\" stroke=\"#d8dfeb\" stroke-width=\"1\"/>\n          <circle cx=\"78\" cy=\"227\" r=\"3\" fill=\"#e8538b\"/><circle cx=\"86\" cy=\"227